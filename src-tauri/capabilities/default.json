{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "sql:default",
    "sql:allow-execute",
    "updater:default",
    "process:default",
    "fs:allow-document-write-recursive",
    "fs:allow-document-meta-recursive",
    "dialog:allow-ask"
  ]
}